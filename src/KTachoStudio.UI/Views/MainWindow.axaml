<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KTachoStudio.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1260" d:DesignHeight="840"
        x:Class="KTachoStudio.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/brand-badge.jpg"
        Title="K-Tacho Studio - TDI Lab Edition"
        Background="{StaticResource BrandCanvasBrush}"
        WindowStartupLocation="CenterScreen"
        Width="1260" Height="840"
        MinWidth="1050" MinHeight="680">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Master Layout Grid (Laravel-style Master Shell) -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ========================================================= -->
        <!-- ROW 0: TOP BRAND & HARDWARE TOOLBAR                       -->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource BrandSurfaceHeaderBrush}"
                BorderBrush="{StaticResource BrandBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Brand / Logo Area -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border CornerRadius="22" ClipToBounds="True" Width="44" Height="44"
                            BorderBrush="{StaticResource BrandElectricCyanBrush}" BorderThickness="2">
                        <Image Source="/Assets/brand-badge.jpg" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="K-TACHO" FontWeight="Black" FontSize="18" LetterSpacing="0.5" Foreground="{StaticResource BrandTextPrimaryBrush}" />
                            <TextBlock Text="STUDIO" FontWeight="Black" FontSize="18" LetterSpacing="0.5" Foreground="{StaticResource BrandElectricCyanBrush}" />
                        </StackPanel>
                        <TextBlock Text="TDI LAB EDITION • VAG K-LINE &amp; EDC15/16 SUITE" 
                                   FontSize="10" FontWeight="Bold" LetterSpacing="1" 
                                   Foreground="{StaticResource BrandNeonLimeBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" />

                <!-- Hardware Connection Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    
                    <!-- Port Selector Pill -->
                    <Border Background="{StaticResource BrandSurfaceAltBrush}"
                            BorderBrush="{StaticResource BrandBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="PORT" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTextMutedBrush}" />
                            <ComboBox ItemsSource="{Binding AvailablePorts}" 
                                      SelectedItem="{Binding SelectedPort}" 
                                      Width="110" Height="28" BorderThickness="0" Background="Transparent" />
                        </StackPanel>
                    </Border>

                    <!-- Baud Selector Pill -->
                    <Border Background="{StaticResource BrandSurfaceAltBrush}"
                            BorderBrush="{StaticResource BrandBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="BAUD" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTextMutedBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableBauds}" 
                                      SelectedItem="{Binding SelectedBaud}" 
                                      Width="145" Height="28" BorderThickness="0" Background="Transparent" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-Detect Port & Baud Button -->
                    <Button Command="{Binding AutoDetectCommand}"
                            Classes="secondary" Height="36" Padding="12,0"
                            ToolTip.Tip="Automatically probe serial ports and candidate VAG baud rates to detect active controller">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="12" Foreground="{StaticResource BrandElectricCyanBrush}" />
                            <TextBlock Text="{Binding AutoDetectButtonText}" FontWeight="Bold" FontSize="10" LetterSpacing="0.8" Foreground="{StaticResource BrandElectricCyanBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Connect Button -->
                    <Button Command="{Binding ToggleConnectionCommand}"
                            Classes="primary" Height="36" Padding="18,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#091018" />
                            <TextBlock Text="{Binding ConnectionStatusText, TargetNullValue='CONNECT'}" FontWeight="Bold" FontSize="11" LetterSpacing="0.8" />
                        </StackPanel>
                    </Button>

                    <!-- Digital OLED Voltage Badge -->
                    <Border Background="#0B1015"
                            BorderBrush="{StaticResource BrandNeonLimeBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Foreground="{StaticResource BrandNeonLimeBrush}" />
                            <TextBlock Text="{Binding BatteryVoltage}" FontSize="12" FontWeight="Black" LetterSpacing="0.5" Foreground="{StaticResource BrandNeonLimeBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 1: TOP HORIZONTAL NAVIGATION TAB BAR                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                Background="#11161E"
                BorderBrush="{StaticResource BrandBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="nav-tab" Command="{Binding NavigateCommand}" CommandParameter="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🚗" FontSize="14" />
                        <TextBlock Text="Vehicle Overview" />
                    </StackPanel>
                </Button>

                <Button Classes="nav-tab" Command="{Binding NavigateCommand}" CommandParameter="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" FontSize="14" />
                        <TextBlock Text="EDC15 / EDC16 Tuning" />
                    </StackPanel>
                </Button>

                <Button Classes="nav-tab" Command="{Binding NavigateCommand}" CommandParameter="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🛡️" FontSize="14" />
                        <TextBlock Text="Cluster &amp; Immo" />
                    </StackPanel>
                </Button>

                <Button Classes="nav-tab" Command="{Binding NavigateCommand}" CommandParameter="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📈" FontSize="14" />
                        <TextBlock Text="Live Diag &amp; Scope" />
                    </StackPanel>
                </Button>

                <Button Classes="nav-tab" Command="{Binding NavigateCommand}" CommandParameter="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🎛️" FontSize="14" />
                        <TextBlock Text="Comfort &amp; Modules" />
                    </StackPanel>
                </Button>

                <Button Classes="nav-tab" Command="{Binding NavigateCommand}" CommandParameter="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📊" FontSize="14" />
                        <TextBlock Text="Hex &amp; K-Line Log" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 2: DYNAMIC OUTLET (RENDERS CURRENT PAGE VIEW)         -->
        <!-- ========================================================= -->
        <TransitioningContentControl Grid.Row="2" Content="{Binding CurrentPage}" />

        <!-- ========================================================= -->
        <!-- ROW 3: BOTTOM TELEMETRY STRIP                             -->
        <!-- ========================================================= -->
        <Border Grid.Row="3"
                Background="{StaticResource BrandSurfaceHeaderBrush}"
                BorderBrush="{StaticResource BrandBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                
                <!-- TX / RX Activity Blinker LEDs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrandElectricCyanBrush}" />
                        <TextBlock Text="TX" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrandNeonLimeBrush}" />
                        <TextBlock Text="RX" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding BottomStatusMessage}"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource BrandTextPrimaryBrush}" Margin="20,0" />

                <!-- Operation Progress Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="{Binding OperationProgressStatus}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandNeonLimeBrush}" VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding OperationProgress}" Maximum="100" Width="160" Height="8"
                                 Foreground="{StaticResource BrandElectricCyanBrush}"
                                 Background="{StaticResource BrandSurfaceAltBrush}"
                                 BorderBrush="{StaticResource BrandBorderBrush}" />
                </StackPanel>

                <!-- Console / Log Drawer Button -->
                <Button Grid.Column="3" Content="▲ K-LINE LOG" Classes="secondary"
                        Padding="12,5" FontSize="10" FontWeight="Bold" />
            </Grid>
        </Border>

    </Grid>

</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KTachoStudio.UI.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="KTachoStudio.UI.Views.Pages.EdcTuningView"
             x:DataType="vm:EdcTuningViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
            
            <!-- Header Info -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="BOSCH EDC15 / EDC16 HIGH-SPEED FLASH WORKBENCH" Classes="header" FontSize="16" Foreground="{StaticResource BrandElectricCyanBrush}" />
                        <TextBlock Text="K-Line flash dumping, writing, sector checksum comparison, and C167 hardware recovery" Classes="muted" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0C141C" BorderBrush="{StaticResource BrandNeonLimeBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,8">
                        <TextBlock Text="{Binding EcuModel}" FontWeight="Black" FontSize="12" Foreground="{StaticResource BrandNeonLimeBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Flash File Configuration -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Target Flash Image &amp; Parameters" Classes="header" />

                    <!-- File Selector Row -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding FlashFilePath}" 
                                 Background="#0F141C" BorderBrush="{StaticResource BrandBorderBrush}" Height="38"
                                 VerticalContentAlignment="Center" FontSize="12" />
                        <Button Grid.Column="1" Content="BROWSE..." Classes="secondary" Margin="10,0" Height="38" Padding="16,0" />
                        <Border Grid.Column="2" Background="#0F141C"
                                BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16,0" VerticalAlignment="Stretch">
                            <TextBlock Text="{Binding FlashFileSize}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandElectricCyanBrush}" />
                        </Border>
                    </Grid>

                    <!-- Safety Toggles -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                        <CheckBox Grid.Column="0" Content="Smart Sector Checksum (Skip unmodified sectors)" 
                                  IsChecked="{Binding SmartSectorCheck}" Margin="0,0,24,0" />
                        <CheckBox Grid.Column="1" Content="Verify Written Blocks After Flash" 
                                  IsChecked="{Binding VerifyChecksum}" Margin="0,0,24,0" />
                        <CheckBox Grid.Column="2" Content="Fast Init (ISO 14230)" 
                                  IsChecked="{Binding FastInitEnabled}" />
                    </Grid>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,10,0,0">
                        <Button Grid.Column="0" Command="{Binding DumpFlashCommand}"
                                Classes="primary" Margin="0,0,8,0" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="⬇️" FontSize="16" />
                                <TextBlock Text="DUMP FLASH MEMORY" FontWeight="Black" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Command="{Binding WriteFlashCommand}"
                                Classes="accent" Margin="8,0,8,0" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="16" />
                                <TextBlock Text="WRITE FLASH IMAGE" FontWeight="Black" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding BootRecoveryCommand}"
                                Classes="secondary" Margin="8,0,0,0" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="16" />
                                <TextBlock Text="C167 BOOT RECOVERY" FontWeight="Black" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Visual 16-Sector Status Matrix -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="CHIP SECTOR ALLOCATION MAP (29F400BT 512KB)" Classes="header" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource BrandNeonLimeBrush}" />
                                <TextBlock Text="Flashed &amp; Verified" FontSize="11" Classes="muted" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource BrandElectricCyanBrush}" />
                                <TextBlock Text="Writing" FontSize="11" Classes="muted" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="10" Height="10" Fill="#121720" />
                                <TextBlock Text="Unchanged (Skipped)" FontSize="11" Classes="muted" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Visual 16 Sectors -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BrandNeonLimeBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 00" Foreground="#0B1304" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BrandNeonLimeBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 01" Foreground="#0B1304" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BrandNeonLimeBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 02" Foreground="#0B1304" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource BrandNeonLimeBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 03" Foreground="#0B1304" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource BrandNeonLimeBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 04" Foreground="#0B1304" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" Background="{StaticResource BrandNeonLimeBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 05" Foreground="#0B1304" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="6" Background="{StaticResource BrandElectricCyanBrush}" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 06" Foreground="#091018" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="7" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 07" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 08" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 09" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 0A" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 0B" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 0C" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="5" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 0D" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="6" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 0E" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="7" Background="#121720" Height="34" Margin="3" CornerRadius="6">
                            <TextBlock Text="SEC 0F" Foreground="{StaticResource BrandTextMutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

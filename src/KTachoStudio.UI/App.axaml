<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KTachoStudio.UI.App"
             xmlns:local="using:KTachoStudio.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- TDI Lab & K-Tacho Brand Palette -->
        <Color x:Key="BrandCanvasColor">#0F1318</Color>
        <Color x:Key="BrandSurfaceColor">#151A22</Color>
        <Color x:Key="BrandSurfaceHeaderColor">#191F29</Color>
        <Color x:Key="BrandSurfaceAltColor">#1E2532</Color>
        <Color x:Key="BrandBorderColor">#283243</Color>
        <Color x:Key="BrandBorderFocusColor">#00AEEF</Color>

        <Color x:Key="BrandElectricCyanColor">#00AEEF</Color>
        <Color x:Key="BrandElectricCyanHoverColor">#29C2FF</Color>
        <Color x:Key="BrandNeonLimeColor">#84CC16</Color>
        <Color x:Key="BrandTitaniumColor">#7F8A96</Color>
        
        <Color x:Key="BrandTextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="BrandTextMutedColor">#8B9BB0</Color>
        <Color x:Key="BrandWarningColor">#F59E0B</Color>
        <Color x:Key="BrandSuccessColor">#10B981</Color>
        <Color x:Key="BrandErrorColor">#EF4444</Color>

        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="BrandCanvasBrush" Color="{StaticResource BrandCanvasColor}" />
        <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurfaceColor}" />
        <SolidColorBrush x:Key="BrandSurfaceHeaderBrush" Color="{StaticResource BrandSurfaceHeaderColor}" />
        <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="{StaticResource BrandSurfaceAltColor}" />
        <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}" />
        <SolidColorBrush x:Key="BrandBorderFocusBrush" Color="{StaticResource BrandBorderFocusColor}" />

        <SolidColorBrush x:Key="BrandElectricCyanBrush" Color="{StaticResource BrandElectricCyanColor}" />
        <SolidColorBrush x:Key="BrandElectricCyanHoverBrush" Color="{StaticResource BrandElectricCyanHoverColor}" />
        <SolidColorBrush x:Key="BrandNeonLimeBrush" Color="{StaticResource BrandNeonLimeColor}" />
        <SolidColorBrush x:Key="BrandTitaniumBrush" Color="{StaticResource BrandTitaniumColor}" />

        <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="{StaticResource BrandTextPrimaryColor}" />
        <SolidColorBrush x:Key="BrandTextMutedBrush" Color="{StaticResource BrandTextMutedColor}" />
        <SolidColorBrush x:Key="BrandWarningBrush" Color="{StaticResource BrandWarningColor}" />
        <SolidColorBrush x:Key="BrandSuccessBrush" Color="{StaticResource BrandSuccessColor}" />
        <SolidColorBrush x:Key="BrandErrorBrush" Color="{StaticResource BrandErrorColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Primary Action Button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource BrandElectricCyanBrush}" />
            <Setter Property="Foreground" Value="#091018" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource BrandElectricCyanHoverBrush}" />
        </Style>

        <!-- Secondary Action Button -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource BrandSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#252E3E" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandElectricCyanBrush}" />
        </Style>

        <!-- Accent Lime Button -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource BrandNeonLimeBrush}" />
            <Setter Property="Foreground" Value="#091204" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="#9CE821" />
        </Style>

        <!-- Top Navigation Bar Tab Button -->
        <Style Selector="Button.nav-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav-tab:pointerover">
            <Setter Property="Background" Value="{StaticResource BrandSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
        </Style>

        <!-- Card Container Style -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <!-- Spec Data Pill -->
        <Style Selector="Border.data-pill">
            <Setter Property="Background" Value="#10141B" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!-- Text Helpers -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextMutedBrush}" />
        </Style>

        <!-- Clean ComboBox Style -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{StaticResource BrandSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
